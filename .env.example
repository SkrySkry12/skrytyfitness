# Skopiuj jako .env i uzupełnij przed wdrożeniem.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://fitness:ZMIEN_TO_HASLO@db:5432/fitness
SESSION_SECRET=ZMIEN_NA_DLUGI_LOSOWY_SEKRET_MIN_32_ZNAKI
ADMIN_USERNAME=skryskry
# Ustaw własne hasło przed pierwszym uruchomieniem. Nie commituj pliku .env.
ADMIN_PASSWORD=USTAW_TUTAJ_SILNE_HASLO
# Opcjonalnie: URL aplikacji, np. https://fitness.twojadomena.pl
APP_URL=

# Opcjonalna analiza AI (klucz wyłącznie po stronie serwera; nigdy w frontendzie)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
