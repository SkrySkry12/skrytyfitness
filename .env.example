# Skopiuj jako .env i uzupełnij przed wdrożeniem. Nie commituj pliku .env.

# --- Wymagane ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://fitness:ZMIEN_TO_HASLO@db:5432/fitness
# Hasło bazy dla usługi "db" w docker-compose (musi pasować do DATABASE_URL)
DB_PASSWORD=ZMIEN_TO_HASLO
# WYMAGANE przy NODE_ENV=production – serwer nie wystartuje bez tego
SESSION_SECRET=ZMIEN_NA_DLUGI_LOSOWY_SEKRET_MIN_32_ZNAKI
ADMIN_USERNAME=skryskry
# Hasło konta admina (ustawiane przy pierwszym uruchomieniu)
ADMIN_PASSWORD=USTAW_TUTAJ_SILNE_HASLO

# --- Opcjonalne ---
# Hasło drugiego konta (kieltyczka, min. 12 znaków). Puste = konto nie jest tworzone.
# Istniejącemu kontu hasło NIE jest zmieniane.
KIELTYCZKA_PASSWORD=
# Domyślna strefa czasowa (każdy użytkownik może ją zmienić w Ustawieniach)
APP_TIMEZONE=Europe/Warsaw
# "true" gdy baza wymaga SSL (np. zewnętrzny Postgres)
PGSSL=false
# URL aplikacji, np. https://fitness.twojadomena.pl
APP_URL=

# Powiadomienia push (wygeneruj: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI – Abacus.AI RouteLLM (szacowanie posiłków + coach). Klucz wyłącznie po stronie serwera.
# Klucz: abacus.ai → RouteLLM API → API Keys
ABACUS_API_KEY=
ABACUS_MODEL=gpt-4.1-mini
# ABACUS_BASE_URL=https://routellm.abacus.ai/v1
# Opcjonalny zapas: używany tylko, gdy ABACUS_API_KEY jest puste
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
